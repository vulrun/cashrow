# Copy to .env.local for local development. Never commit real values.
# Every VITE_* value is public: it ships inside the JavaScript bundle.
# An OAuth client ID is not a secret, but keep it restricted to your own origins.

# Required for Google sign-in. Create it in Google Cloud Console:
# APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
# See docs/google-cloud-setup.md.
VITE_GOOGLE_CLIENT_ID=

# Show "Try the demo" on the sign-in screen. Demo data stays in this browser only.
VITE_ENABLE_DEMO=true

# Routing. "browser" (clean URLs, needs an SPA fallback) or "hash" (works on any static host).
VITE_ROUTER_MODE=browser

# Sub-path the app is served from. "/" for a domain root, "/cashrow/" for GitHub Pages.
VITE_BASE_PATH=/

# Name shown in the header and browser tab. "cashrow" shows the two-tone wordmark.
VITE_APP_NAME=cashrow
